# Copy to .env for local dev. In production, set these in Vercel > Project > Settings > Environment Variables.

# ---- Slack (production relay app — created in your Slack workspace) ----
# Leave BLANK for local testing: the relay runs in MOCK mode (no real Slack calls).
SLACK_BOT_TOKEN=            # xoxb-... (Bot User OAuth Token)
SLACK_SIGNING_SECRET=       # from the Slack app's Basic Information page
SLACK_CHANNEL_ID=C0BQ4R57NSF   # #website-chat

# ---- OpenAI + Pinecone (reuse the same ones the pipeline uses) ----
# Leave BLANK for local testing: AI draft/fallback is skipped (canned messages).
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=syncro-kb
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# ---- Storage (production) ----
# Upstash Redis REST (free tier). Leave blank locally to use a JSON file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Admin ----
ADMIN_KEY=                  # a password for the control panel (set something in production)
